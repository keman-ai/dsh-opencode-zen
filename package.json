{
  "name": "dsh-opencode-zen",
  "version": "0.1.0",
  "description": "Bring OpenCode Zen's free models to DeepSeek Harness — an LLM provider plugin that adds 7 free models to the picker, no API key required",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "llm",
    "provider",
    "opencode",
    "zen",
    "free-models"
  ],
  "license": "MIT",
  "author": "Science Roam Limited",
  "homepage": "https://github.com/keman-ai/dsh-opencode-zen#readme",
  "bugs": {
    "url": "https://github.com/keman-ai/dsh-opencode-zen/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keman-ai/dsh-opencode-zen.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "prepublishOnly": "tsdown"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsdown": "^0.15.6",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
